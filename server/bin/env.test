# API-DOC 后端测试环境配置（bin/run.sh 默认加载本文件）
# 生产部署必须替换 JWT_SECRET / SECRET_ENCRYPT_KEY / ADMIN_PASSWORD。
PORT=2027
GIN_MODE=debug

# 数据库：sqlite（默认）| postgres
DB_DRIVER=sqlite
DB_DSN=data/apidoc.db

UPLOAD_DIR=data/uploads

JWT_SECRET=apidoc-test-jwt-secret
JWT_EXPIRE_HOURS=24
SECRET_ENCRYPT_KEY=apidoc-test-encrypt-key

# 启动时若不存在则自动创建的默认超级管理员
ADMIN_NAME=admin
ADMIN_PASSWORD=admin123

BACKUP_ENABLED=false
BACKUP_DIR=data/backups
LOG_RETENTION_DAYS=70
